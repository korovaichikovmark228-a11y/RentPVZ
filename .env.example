# Telegram — куда падают заявки с лендинга.
# 1. Напиши @BotFather в Telegram → /newbot → получи токен.
# 2. Узнай свой chat_id: напиши @userinfobot, он пришлёт число.
# 3. Один раз напиши что-нибудь своему новому боту, иначе он не сможет тебе писать.
TELEGRAM_BOT_TOKEN=123456789:AA...your-token
TELEGRAM_CHAT_ID=123456789
